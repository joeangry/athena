{
  "name": "@kammersgaard/athena",
  "version": "0.0.3",
  "main": "index.tsx",
  "scripts": {
    "start": "react-scripts start",
    "build:react": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "storybook": "storybook dev --no-open -p 6006",
    "build": "npm run build:components && npm run build:icons",
    "build-storybook": "storybook build -s public",
    "build:components": "tsc -p ./tsconfig.components.json",
    "build:icons": "tsc -p ./tsconfig.icons.json"
  },
  "dependencies": {
    "@babel/plugin-proposal-private-property-in-object": "7.21.11",
    "@testing-library/jest-dom": "5.14.1",
    "@testing-library/react": "12.1.2",
    "@testing-library/user-event": "13.4.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "styled-components": "5.3.1",
    "webpack": "5.104.1"
  },
  "devDependencies": {
    "@babel/plugin-transform-react-jsx-self": "7.14.9",
    "@babel/plugin-transform-react-jsx-source": "7.14.5",
    "@babel/plugin-transform-runtime": "7.15.0",
    "@storybook/addon-a11y": "10.1.10",
    "@storybook/addon-docs": "10.1.10",
    "@storybook/addon-links": "10.1.10",
    "@storybook/preset-create-react-app": "10.1.10",
    "@storybook/react-webpack5": "10.1.10",
    "@types/react": "18.3.5",
    "@types/react-dom": "18.3.0",
    "@types/styled-components": "5.1.34",
    "@vitest/mocker": "^4.0.16",
    "babel-loader": "8.2.2",
    "postcss-selector-parser": "6.1.2",
    "sass": "1.78.0",
    "sass-loader": "12.2.0",
    "storybook": "10.1.10",
    "style-loader": "4.0.0",
    "typescript": "4.9.4"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
